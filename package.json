{
  "name": "ironbark-electrical",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ironbark Electrical - the marketing demo business app: Ironbark Electrical, a small trade contractor. Console shell over @kabosh-digital/m-street-kit plus its own business domain.",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p ${PORT:-3200}",
    "build": "next build",
    "start": "next start -p ${PORT:-3200}",
    "worker": "tsx --env-file=.env src/worker.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate --schema node_modules/@kabosh-digital/workflow-schema/prisma/schema.prisma && prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema node_modules/@kabosh-digital/workflow-schema/prisma/schema.prisma",
    "app:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "app:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "seed:prices": "tsx --env-file=.env scripts/seedPrices.ts",
    "reset": "tsx --env-file=.env scripts/reset.ts",
    "demo:check": "tsx --env-file=.env scripts/preflight.ts",
    "demo:reset": "tsx --env-file=.env scripts/reset.ts && tsx --env-file=.env scripts/seedWorkflows.ts --publish",
    "runs:reconcile": "tsx --env-file=.env scripts/reconcileRuns.ts",
    "payments:replay": "tsx --env-file=.env scripts/replayStripePayments.ts",
    "workflows:seed": "tsx --env-file=.env scripts/seedWorkflows.ts",
    "workflows:try": "tsx --env-file=.env scripts/tryWorkflow.ts"
  },
  "dependencies": {
    "@kabosh-digital/m-street-kit": "0.3.0",
    "@kabosh-digital/ui-kit": "0.3.0",
    "@kabosh-digital/workflow-schema": "0.3.0",
    "@kabosh-digital/workflow-temporal": "0.3.0",
    "@kabosh-digital/workflow-types": "0.3.0",
    "@prisma/client": "^6.2.1",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.10.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "prisma": "^6.2.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
