// Ironbark Electrical business data (Ironbark Electrical). Lives in its own Postgres
// schema ("ironbark-electrical") next to the platform's tables, with its own client and
// migration history. Business tables reference platform users by plain id
// strings (Prisma cannot relate across two schemas) - validated in code.
//
// The client is generated into node_modules under an ordinary package name, so
// every tool (TypeScript, Vite, tsx, Next) resolves it like a dependency and Next
// treats it as external (a client generated inside src/ gets bundled and loses its
// query engine). `pnpm install` regenerates it (postinstall).

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/ironbark-electrical-client"
}

datasource db {
  provider = "postgresql"
  url      = env("APP_DATABASE_URL")
}

enum ClientType {
  PERSON
  COMPANY
}

enum ContactMethod {
  EMAIL
  PHONE
}

enum RequestSource {
  EMAIL
  PHONE
  MANUAL
  WEB
}

enum RequestCategory {
  NEW_INSTALL
  FAULT_REPAIR
  QUOTE_REQUEST
  OTHER
}

enum Urgency {
  ROUTINE
  URGENT
  EMERGENCY
}

enum RequestStatus {
  NEW
  CONTACTED
  SITE_VISIT_BOOKED
  QUOTED
  WON
  LOST
}

enum SiteVisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum PriceKind {
  LABOUR
  CALL_OUT
  STANDARD_JOB
  MATERIAL
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  DECLINED
  EXPIRED
}

enum JobStatus {
  UNSCHEDULED
  SCHEDULED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  INVOICED
  PAID
}

enum JobNoteKind {
  NOTE
  VARIATION
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CARD
  BANK
  CASH
  STRIPE
}

enum PaymentKind {
  DEPOSIT
  INVOICE
}

enum ActorType {
  USER
  WORKFLOW
  SYSTEM
}

model Client {
  id               String        @id @default(cuid())
  type             ClientType    @default(PERSON)
  name             String
  email            String?
  phone            String?
  /// Lower-cased, trimmed email / digits-only phone (AU numbers normalised to
  /// the national form) - used for matching and duplicate hints, never shown.
  emailNorm        String?
  phoneNorm        String?
  preferredContact ContactMethod @default(EMAIL)
  tags             String[]      @default([])
  notes            String?
  archivedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sites    Site[]
  requests Request[]
  activity ActivityEvent[]
  quotes   Quote[]
  jobs     Job[]
  invoices Invoice[]

  @@index([emailNorm])
  @@index([phoneNorm])
  @@index([name])
}

model Site {
  id               String   @id @default(cuid())
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label            String?
  line1            String
  line2            String?
  suburb           String
  state            String   @default("NSW")
  postcode         String
  accessNotes      String?
  switchboardNotes String?
  createdAt        DateTime @default(now())

  requests Request[]
  quotes   Quote[]
  jobs     Job[]

  @@index([clientId])
}

model Request {
  id              String          @id @default(cuid())
  clientId        String?
  client          Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  siteId          String?
  site            Site?           @relation(fields: [siteId], references: [id], onDelete: SetNull)
  source          RequestSource
  receivedAt      DateTime        @default(now())
  category        RequestCategory @default(OTHER)
  urgency         Urgency         @default(ROUTINE)
  status          RequestStatus   @default(NEW)
  statusChangedAt DateTime        @default(now())
  /// Platform user id of whoever owns following this up.
  ownerUserId     String?
  /// Who the enquirer is when no Client is linked yet.
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  summary         String
  description     String?
  lostReason      String?
  /// Reference to the inbound email (message id), when it came from Gmail.
  rawEmailRef     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  quotes     Quote[]
  siteVisits SiteVisit[]

  @@index([status, receivedAt])
  @@index([clientId])
}

/// An electrician looking at the job before it is quoted. Client and site come from the request.
model SiteVisit {
  id             String          @id @default(cuid())
  requestId      String
  request        Request         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status         SiteVisitStatus @default(SCHEDULED)
  /// Platform user id of the technician.
  assignedUserId String
  scheduledStart DateTime
  scheduledEnd   DateTime
  /// What the technician found and what the job needs; carried into the quote.
  findings       String?
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([assignedUserId, scheduledStart])
  @@index([requestId])
  @@index([status])
}

/// The unified timeline: every module records what happened here, whether a
/// person or a workflow did it.
model ActivityEvent {
  id                 String    @id @default(cuid())
  at                 DateTime  @default(now())
  actorType          ActorType
  /// Platform user id when actorType is USER.
  actorUserId        String?
  /// Display name of the actor ("Priya", "Enquiry to reply workflow").
  actorLabel         String?
  clientId           String?
  client             Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  entityType         String
  entityId           String
  /// CREATED | UPDATED | NOTE | STATUS_CHANGED | LINKED | ARCHIVED | ...
  kind               String
  summary            String
  body               String?
  workflowInstanceId String?

  @@index([clientId, at(sort: Desc)])
  @@index([entityType, entityId, at(sort: Desc)])
}

/// Human-readable numbering (Q-1001, J-2001): one counter row per sequence.
model Sequence {
  key   String @id
  value Int    @default(0)
}

/// Wording of the emails the automations send. `key` is what a workflow's email step refers to, so it never
/// changes after creation; everything else is edited freely. Body is light markup (see render.ts).
model EmailTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  subject     String
  body        String
  /// Variables the template expects, for the editor's help text and preview ("clientFirstName", "number", ...).
  variables   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// The price list: labour rates, call-out fee, standard jobs and materials.
/// Amounts are integer cents, ex GST. Technicians never see this table.
model PriceItem {
  id          String    @id @default(cuid())
  kind        PriceKind
  name        String
  description String?
  unit        String    @default("each")
  /// Materials only: what it costs us, and the markup that produces priceCents.
  costCents   Int?
  markupPct   Int?
  priceCents  Int
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lines       QuoteLine[]
  bundleItems PriceBundleItem[]

  @@index([kind, active])
}

/// A named set of price-list items added to a quote in one click (e.g. "Switchboard upgrade package").
/// It has no price of its own: each line takes the item's current price when it is added.
model PriceBundle {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items PriceBundleItem[]
}

model PriceBundleItem {
  id          String      @id @default(cuid())
  bundleId    String
  bundle      PriceBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  priceItemId String
  priceItem   PriceItem   @relation(fields: [priceItemId], references: [id], onDelete: Restrict)
  quantity    Decimal     @default(1) @db.Decimal(10, 2)
  sortOrder   Int         @default(0)

  @@index([bundleId, sortOrder])
}

model Quote {
  id              String      @id @default(cuid())
  number          String      @unique
  clientId        String
  client          Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  siteId          String?
  site            Site?       @relation(fields: [siteId], references: [id], onDelete: SetNull)
  requestId       String?
  request         Request?    @relation(fields: [requestId], references: [id], onDelete: SetNull)
  status          QuoteStatus @default(DRAFT)
  title           String
  notes           String?
  /// A SENT quote past this moment reads as expired (see effectiveQuoteStatus).
  validUntil      DateTime
  depositRequired Boolean     @default(false)
  depositPct      Int         @default(0)
  subtotalCents   Int         @default(0)
  gstCents        Int         @default(0)
  totalCents      Int         @default(0)
  depositCents    Int         @default(0)
  sentAt          DateTime?
  decidedAt       DateTime?
  decisionNote    String?
  /// Secret in the customer's accept/decline link (/accept/<token>); created when the quote is emailed.
  acceptToken     String?     @unique
  createdByUserId String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  lines QuoteLine[]
  job   Job?

  @@index([status])
  @@index([clientId])
}

model QuoteLine {
  id             String     @id @default(cuid())
  quoteId        String
  quote          Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position       Int
  priceItemId    String?
  priceItem      PriceItem? @relation(fields: [priceItemId], references: [id], onDelete: SetNull)
  description    String
  quantity       Decimal    @db.Decimal(10, 2)
  unit           String     @default("each")
  unitPriceCents Int
  /// Ex GST: round(quantity x unitPriceCents).
  lineTotalCents Int

  @@index([quoteId, position])
}

model Job {
  id                  String    @id @default(cuid())
  number              String    @unique
  clientId            String
  client              Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  siteId              String?
  site                Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  quoteId             String?   @unique
  quote               Quote?    @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  title               String
  scope               String?
  status              JobStatus @default(UNSCHEDULED)
  /// Platform user id of the technician.
  assignedUserId      String?
  scheduledStart      DateTime?
  scheduledEnd        DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  /// What was quoted, ex GST (the invoice starts from this plus approved variations).
  quotedSubtotalCents Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  notes    JobNote[]
  /// A job can be invoiced again after a void: at most one non-void invoice at a time.
  invoices Invoice[]
  payments Payment[]

  @@index([assignedUserId, scheduledStart])
  @@index([status])
}

model JobNote {
  id               String      @id @default(cuid())
  jobId            String
  job              Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorUserId     String
  authorLabel      String
  kind             JobNoteKind @default(NOTE)
  text             String
  /// A variation's extra labour/parts, ex GST. Counts toward the invoice only once approved.
  extraCents       Int?
  approved         Boolean     @default(false)
  approvedByUserId String?
  createdAt        DateTime    @default(now())

  @@index([jobId, createdAt])
}

model Invoice {
  id              String        @id @default(cuid())
  number          String        @unique
  jobId           String
  job             Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  siteId          String?
  status          InvoiceStatus @default(DRAFT)
  issuedAt        DateTime?
  dueAt           DateTime?
  paidAt          DateTime?
  subtotalCents   Int           @default(0)
  gstCents        Int           @default(0)
  totalCents      Int           @default(0)
  /// Deposit already received for this job, credited against the total (incl GST).
  creditCents     Int           @default(0)
  notes           String?
  voidReason      String?
  /// Set when a payment provider (Stripe) issues the payment link.
  stripeInvoiceId String?
  payUrl          String?
  createdByUserId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lines    InvoiceLine[]
  payments Payment[]

  @@index([status])
  @@index([clientId])
  @@index([jobId])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position       Int
  /// QUOTE | VARIATION | MANUAL - where the line came from.
  source         String  @default("QUOTE")
  description    String
  quantity       Decimal @db.Decimal(10, 2)
  unit           String  @default("each")
  unitPriceCents Int
  /// Ex GST: round(quantity x unitPriceCents).
  lineTotalCents Int

  @@index([invoiceId, position])
}

/// Money received. A DEPOSIT belongs to a job until an invoice is raised, then it
/// is applied (invoiceId set) and shows as the invoice's credit; INVOICE payments
/// belong to the invoice.
model Payment {
  id               String        @id @default(cuid())
  kind             PaymentKind   @default(INVOICE)
  invoiceId        String?
  invoice          Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  jobId            String?
  job              Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  method           PaymentMethod
  amountCents      Int
  paidAt           DateTime      @default(now())
  reference        String?
  stripePaymentId  String?
  recordedByUserId String
  createdAt        DateTime      @default(now())

  @@index([invoiceId])
  @@index([jobId, kind])
}
