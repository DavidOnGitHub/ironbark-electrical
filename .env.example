# Platform schema (workflows, users, connectors) - public schema of the demo's own database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iron_spark?schema=public"
# Business schema (clients, requests, ...) - same database, schema "iron-spark".
APP_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iron_spark?schema=iron-spark"
TEMPORAL_ADDRESS="localhost:7233"
# TARGET: a dedicated namespace on the shared Temporal server ("iron-spark") so this app
# never shares workers with another business. That needs the platform release in which the
# worker honours TEMPORAL_NAMESPACE (released 0.2.0 workers always poll "default"). Until then
# use "default" on a Temporal server that only this app uses.
TEMPORAL_NAMESPACE="default"
# openssl rand -base64 32  (one per deployment)
CONNECTOR_ENCRYPTION_KEY=""
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3000"
ADMIN_EMAILS="owner@ironbark.test"
TRUSTED_PROXY_HOPS="1"
BRANDING_BUSINESS_NAME="Ironbark Electrical"
# Google connector OAuth app (a dedicated demo Google account/project) - later phases.
GOOGLE_CONNECTOR_CLIENT_ID=""
GOOGLE_CONNECTOR_CLIENT_SECRET=""
# Stripe, TEST MODE keys (sk_test_..., whsec_...). Without STRIPE_SECRET_KEY invoices simply have no pay link.
# The webhook endpoint to register in the Stripe dashboard: <APP_BASE_URL>/api/stripe/webhook
# (event: checkout.session.completed). Locally: `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Where the app is reachable (used for the payment page's return links).
APP_BASE_URL="http://localhost:3000"
# The business's Google review link, sent in the review request email.
REVIEW_URL="https://g.page/r/ironbark-electrical/review"
# "off" stops the automations starting at all (a published workflow otherwise starts on quote sent / invoice issued / paid).
AUTOMATIONS="on"
