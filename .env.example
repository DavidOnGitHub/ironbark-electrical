# Platform schema (workflows, users, connectors) - public schema of the demo's own database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ironbark_electrical?schema=public"
# Business schema (clients, requests, ...) - same database, schema "ironbark-electrical".
APP_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ironbark_electrical?schema=ironbark-electrical"
TEMPORAL_ADDRESS="localhost:7233"
# TARGET: a dedicated namespace on the shared Temporal server ("ironbark-electrical") so this app
# never shares workers with another business. That needs the platform release in which the
# worker honours TEMPORAL_NAMESPACE (released 0.2.0 workers always poll "default"). Until then
# use "default" on a Temporal server that only this app uses.
TEMPORAL_NAMESPACE="default"
# openssl rand -base64 32  (one per deployment)
CONNECTOR_ENCRYPTION_KEY=""
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3200"
ADMIN_EMAILS="owner@ironbark.test"
TRUSTED_PROXY_HOPS="1"
BRANDING_BUSINESS_NAME="Ironbark Electrical"
# Google connector OAuth app (a dedicated demo Google account/project) - later phases.
GOOGLE_CONNECTOR_CLIENT_ID=""
GOOGLE_CONNECTOR_CLIENT_SECRET=""
# Stripe, TEST MODE keys (sk_test_..., whsec_...). Without STRIPE_SECRET_KEY invoices simply have no pay link.
# The webhook endpoint to register in the Stripe dashboard: <APP_BASE_URL>/api/stripe/webhook
# (event: checkout.session.completed). Locally: `stripe listen --api-key "$STRIPE_SECRET_KEY" --forward-to localhost:3200/api/stripe/webhook`
# (--api-key makes the CLI listen to the SAME Stripe account as the key above; without it the CLI uses whichever account it is logged into).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Security scans: the GitHub Actions scan jobs sign their report with this secret and post it to <APP_BASE_URL>/api/it/scan.
# Generate with `openssl rand -hex 32`; set the same value as the IT_SCAN_SECRET repo secret. Without it the endpoint answers 503.
IT_SCAN_SECRET=""
# How often the scheduled security scan runs: weekly (the default), fortnightly, monthly or never. The workflow checks every
# day and the app decides whether a scan is due. "Scan now" works whatever this says.
IT_SCAN_FREQUENCY=""
# "Scan now" on the Security tab asks GitHub to run the scan workflow. IT_SCAN_REPO is owner/name; IT_SCAN_DISPATCH_TOKEN is a
# fine-grained token with only Actions: read and write on that one repository. Without both the button is not shown.
IT_SCAN_REPO=""
IT_SCAN_DISPATCH_TOKEN=""
# Where the app is reachable (used for the payment page's return links).
APP_BASE_URL="http://localhost:3200"
# The business's Google review link, sent in the review request email.
REVIEW_URL="https://g.page/r/ironbark-electrical/review"
# "off" stops the automations starting at all (a published workflow otherwise starts on quote sent / invoice issued / paid).
AUTOMATIONS="on"

# --- Real email safety (the demo runs on real Gmail) ---
# Who the automations may email. DEFAULT IS DENY: with nothing here no automated mail is sent and the
# workflows hand the job to a person. Exact addresses and/or @domains, comma separated; "*" = everyone.
# Gmail "+tags" are ignored, so me@gmail.com also allows me+pat@gmail.com.
EMAIL_ALLOWLIST=""
# A real inbox to receive the demo's emails: the seed points a few clients at plus-aliases of it
# (me+pat@gmail.com). The enquiry workflow's inbox trigger only reads mail sent to me+ironbark@gmail.com.
DEMO_INBOX=""
# Optional: the plus-tag the inbox trigger listens on (default "ironbark").
DEMO_INBOX_TAG="ironbark"

# IT assistant (AI Builder). Leave empty to switch it off; requests then wait as "Submitted".
AI_BUILDER_URL=""
AI_BUILDER_APP_ID="ironbark-electrical"
AI_BUILDER_TOKEN=""

# The IT assistant. IT_AUTOFIX=on lets a new or returning error open a fix request on its own (costs AI Builder budget; off by default).
# With ANTHROPIC_API_KEY set, a model classifies each new error (code bug, outage, bad data, user error); without it, plain rules do.
# IT_FIX_COST_CAP_USD (default 5) stops an automated fix that has cost more than this.
# IT_DEMO_BREAK=on shows the Owner a "break something on purpose" switch on the IT page. Staging only; never production.
IT_AUTOFIX=""
# Fixes for security scan findings (high and critical only) open on their own whether or not IT_AUTOFIX is on. Set this to
# "off" to stop them; each is still held to IT_FIX_COST_CAP_USD, at most three open per scan, and a person approves the result.
IT_SECURITY_AUTOFIX=""
# A failed workflow run that needs the workflow changed (not the code) is fixed by the workflow assistant: it prepares the
# change and a person applies it in the workflow editor. Set both on the web service AND the worker (the same secret, 16+
# characters). WORKFLOW_FIX_URL is the web service's address, for example http://localhost:3000. Closed until both are set.
WORKFLOW_FIX_URL=""
WORKFLOW_FIX_SECRET=""
IT_DEMO_BREAK=""
