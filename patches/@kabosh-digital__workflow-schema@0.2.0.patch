+
+/** App-level assistant conversation threads (PLAN-app-assistant.md Phase A).
+ * Unlike AssistantConversation (per-workflow-definition), this is app-wide -
+ * scoped only to the user, since the floating assistant is the same thread
+ * across every page, not one per workflow. */
+model AppAssistantConversation {
+  id        String   @id @default(cuid())
+  userId    String
+  /** First question, truncated - shown in the thread picker. */
+  title     String
+  createdAt DateTime @default(now())
+  updatedAt DateTime @updatedAt
+  messages  AppAssistantConversationMessage[]
+
+  @@index([userId, updatedAt])
+}
+
+model AppAssistantConversationMessage {
+  id             String   @id @default(cuid())
+  conversationId String
+  conversation   AppAssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
+  role           String // "user" | "assistant"
+  content        String
+  createdAt      DateTime @default(now())
+
+  @@index([conversationId, createdAt])
+}
