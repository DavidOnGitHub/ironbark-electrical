+++ b/src/routes/api/app-assistant/conversations/[id]/route.ts
@@ -0,0 +1,32 @@
+import { NextRequest } from "next/server";
+import { prisma } from "@kabosh-digital/workflow-schema";
+import { requireRole } from "../../../../../lib/auth";
+import { Policy } from "../../../../../lib/policy";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+/** Load an app-assistant conversation's full message history - owner only. */
+export async function GET(_req: NextRequest, ctx: { params: Promise<{ id: string }> }) {
+  let user;
+  try {
+    user = await requireRole(Policy.APP_ASSISTANT);
+  } catch {
+    return Response.json({ error: "Unauthorized: sign in as an Owner or Office user to use the assistant." }, { status: 401 });
+  }
+  const { id } = await ctx.params;
+
+  const conversation = await prisma.appAssistantConversation.findUnique({
+    where: { id },
+    select: { id: true, userId: true, title: true },
+  });
+  if (!conversation) return Response.json({ error: "Conversation not found." }, { status: 404 });
+  if (conversation.userId !== user.id) return Response.json({ error: "Forbidden." }, { status: 403 });
+
+  const messages = await prisma.appAssistantConversationMessage.findMany({
+    where: { conversationId: id },
+    orderBy: { createdAt: "asc" },
+    select: { role: true, content: true, createdAt: true },
+  });
+  return Response.json({ conversation: { id, title: conversation.title, messages } });
+}
