--- /dev/null
+++ b/src/lib/mfaGate.ts
@@ -0,0 +1,14 @@
+import { redirect } from "next/navigation";
+import { auth } from "./auth";
+
+/**
+ * For console PAGES: an admin who hasn't set up or entered an authenticator
+ * code yet is sent to the code form (and back to `next` afterwards), so every
+ * page shows the same step instead of a page that is quietly missing their
+ * admin rights. Server actions and route handlers don't use this - they fail
+ * instead of redirecting.
+ */
+export async function redirectIfMfaPending(next: string) {
+  const state = (await auth())?.user?.mfa;
+  if (state === "setup" || state === "required") redirect(`/auth/mfa?next=${encodeURIComponent(next)}`);
+}
