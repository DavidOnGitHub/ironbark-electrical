diff --git a/src/components/AppAssistant.tsx b/src/components/AppAssistant.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c5ff8c7714fcc4222ec91730bdeedb5b4f49c2ba
--- /dev/null
+++ b/src/components/AppAssistant.tsx
@@ -0,0 +1,276 @@
+"use client";
+
+import { useCallback, useEffect, useRef, useState } from "react";
+import { Bot, Loader2, MessageSquarePlus, Send, X } from "lucide-react";
+import type { AssistantMessage } from "../lib/assistant";
+import { parseAssistantSse } from "../lib/assistantStream";
+import { Button } from "../ui/button";
+import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription } from "../ui/dialog";
+import { Textarea } from "../ui/textarea";
+import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "../ui/select";
+import { cn } from "../lib/utils";
+
+interface ConversationSummary {
+  id: string;
+  title: string;
+  updatedAt: string;
+}
+
+/**
+ * App-level assistant (PLAN-app-assistant.md Phase B): a floating launcher,
+ * mounted once in KitRootLayout for every ADMIN/EDITOR session, that opens a
+ * chat answering questions from the business/app's data via the server-side
+ * tool-calling loop (appAssistantLoop.ts). Read-only - there is no edit
+ * proposal/apply flow here, unlike WorkflowAssistant, which this otherwise
+ * mirrors (floating button, Dialog, thread picker, persisted conversations).
+ *
+ * The server computes the whole reply before sending anything (the
+ * tool-calling loop isn't a token stream - see appAssistantServer.ts's doc
+ * comment), so there is no partial-content bubble here: the dialog shows a
+ * single "Thinking…" state with an elapsed timer until the one `delta` event
+ * arrives with the complete answer.
+ */
+export function AppAssistant() {
+  const [open, setOpen] = useState(false);
+  const [conversations, setConversations] = useState<ConversationSummary[]>([]);
+  const [conversationId, setConversationId] = useState<string | null>(null);
+  const [messages, setMessages] = useState<AssistantMessage[]>([]);
+  const [input, setInput] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [elapsed, setElapsed] = useState(0);
+  const abortRef = useRef<AbortController | null>(null);
+
+  useEffect(() => () => abortRef.current?.abort(), []);
+
+  const loadConversations = useCallback(async () => {
+    try {
+      const res = await fetch("/api/app-assistant/conversations");
+      if (res.ok) {
+        const data = (await res.json()) as { conversations: ConversationSummary[] };
+        setConversations(data.conversations);
+      }
+    } catch {
+      // list is a nicety - the dialog still works without it
+    }
+  }, []);
+
+  useEffect(() => {
+    if (open) void loadConversations();
+  }, [open, loadConversations]);
+
+  async function loadThread(threadId: string) {
+    setConversationId(threadId);
+    setMessages([]);
+    setError(null);
+    try {
+      const res = await fetch(`/api/app-assistant/conversations/${encodeURIComponent(threadId)}`);
+      if (!res.ok) return;
+      const data = (await res.json()) as {
+        conversation: { id: string; title: string; messages: { role: string; content: string }[] };
+      };
+      setMessages(
+        data.conversation.messages.map((m) => ({
+          role: m.role === "assistant" ? "assistant" : "user",
+          content: m.content,
+        })),
+      );
+    } catch {
+      setError("Could not load this conversation.");
+    }
+  }
+
+  function newChat() {
+    setConversationId(null);
+    setMessages([]);
+    setError(null);
+  }
+
+  async function send() {
+    const question = input.trim();
+    if (!question || busy) return;
+    setError(null);
+    const history = [...messages, { role: "user" as const, content: question }];
+    setMessages(history);
+    setInput("");
+    setBusy(true);
+    setElapsed(0);
+
+    const startedAt = Date.now();
+    const tick = setInterval(() => setElapsed(Math.round((Date.now() - startedAt) / 1000)), 1000);
+    // Hard client-side cap (longer than the loop's own per-request timeouts):
+    // a multi-round tool-calling turn can take a while, but it must not hang
+    // the dialog forever.
+    const controller = new AbortController();
+    abortRef.current = controller;
+    const hardTimeout = setTimeout(() => controller.abort(), 120_000);
+
+    try {
+      const res = await fetch("/api/app-assistant", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ ...(conversationId ? { conversationId } : {}), messages: history }),
+        signal: controller.signal,
+      });
+      if (!res.ok) {
+        const data = (await res.json().catch(() => null)) as { error?: string } | null;
+        setError(data?.error ?? `Assistant request failed (${res.status}).`);
+        return;
+      }
+      if (!res.body) {
+        setError("The assistant returned an empty response.");
+        return;
+      }
+      let content = "";
+      let failed = false;
+      for await (const event of parseAssistantSse(res)) {
+        if ("conversationId" in event) setConversationId(event.conversationId);
+        else if ("delta" in event) content += event.delta;
+        else if ("error" in event) {
+          failed = true;
+          setError(event.error);
+          break;
+        } else break;
+      }
+      if (!failed && content.trim() === "") {
+        failed = true;
+        setError("The assistant returned an empty response. Please try again.");
+      }
+      if (!failed) {
+        setMessages([...history, { role: "assistant", content }]);
+        void loadConversations();
+      }
+    } catch (err) {
+      if (controller.signal.aborted) {
+        setError("The assistant took too long to respond. Please try again.");
+      } else {
+        setError(err instanceof Error ? err.message : "Assistant request failed.");
+      }
+    } finally {
+      clearInterval(tick);
+      clearTimeout(hardTimeout);
+      abortRef.current = null;
+      setBusy(false);
+    }
+  }
+
+  return (
+    <>
+      <Button
+        onClick={() => setOpen(true)}
+        size="icon"
+        aria-label="Open assistant"
+        title="Assistant"
+        // Stacked ABOVE the workflow-editor assistant's button (bottom-6
+        // right-6), not beside it: bottom-left was tried first but collides
+        // with Next.js's own dev-mode toolbar indicator, which docks there
+        // too and sits on top (confirmed live - it intercepts clicks meant
+        // for this button). This button only coexists with WorkflowAssistant
+        // on the definition edit page; everywhere else it's the only one.
+        className="fixed right-6 bottom-24 z-40 size-12 rounded-full shadow-lg"
+      >
+        <Bot className="size-6" />
+      </Button>
+
+      <Dialog open={open} onOpenChange={setOpen}>
+        <DialogContent showCloseButton={false} className="flex h-[min(75vh,36rem)] flex-col gap-0 p-0 sm:max-w-xl">
+          <DialogHeader className="flex-row items-center justify-between gap-3 border-b px-4 py-3">
+            <div>
+              <DialogTitle className="flex items-center gap-2 text-sm">
+                <Bot className="size-4 text-teal-accent" />
+                Assistant
+              </DialogTitle>
+              <DialogDescription className="mt-0.5 text-xs">Ask about your business or this console.</DialogDescription>
+            </div>
+            <div className="flex items-center gap-2">
+              <Select
+                value={conversationId ?? "__new__"}
+                onValueChange={(v) => {
+                  if (v === "__new__") newChat();
+                  else void loadThread(v);
+                }}
+              >
+                <SelectTrigger aria-label="Conversation" className="h-8 w-44 text-xs">
+                  <SelectValue placeholder="New chat" />
+                </SelectTrigger>
+                <SelectContent>
+                  <SelectItem value="__new__">New chat</SelectItem>
+                  {conversations.map((c) => (
+                    <SelectItem key={c.id} value={c.id}>
+                      <span className="line-clamp-1 max-w-40">{c.title}</span>
+                    </SelectItem>
+                  ))}
+                </SelectContent>
+              </Select>
+              <Button variant="ghost" size="icon" onClick={newChat} aria-label="New conversation" title="New conversation">
+                <MessageSquarePlus className="size-4" />
+              </Button>
+              <Button variant="ghost" size="icon" onClick={() => setOpen(false)} aria-label="Close assistant">
+                <X className="size-4" />
+              </Button>
+            </div>
+          </DialogHeader>
+
+          <div className="flex min-h-0 flex-1 flex-col gap-3 overflow-y-auto px-4 py-4">
+            {messages.length === 0 ? (
+              <p className="mx-auto max-w-xs py-8 text-center text-sm text-muted-foreground">
+                Ask anything about your business or this console - e.g. what&rsquo;s overdue, what&rsquo;s waiting on approval, or what a
+                connector does.
+              </p>
+            ) : (
+              messages.map((m, i) => (
+                <div key={i} className={cn("flex", m.role === "user" ? "justify-end" : "justify-start")}>
+                  <div
+                    className={cn(
+                      "max-w-[85%] rounded-2xl px-3.5 py-2 text-sm whitespace-pre-wrap",
+                      m.role === "user"
+                        ? "rounded-br-sm bg-teal-accent text-teal-accent-foreground"
+                        : "rounded-bl-sm border border-border bg-muted text-foreground",
+                    )}
+                  >
+                    {m.content}
+                  </div>
+                </div>
+              ))
+            )}
+            {busy ? (
+              <div className="flex items-center gap-2 rounded-lg border border-teal-accent/40 bg-teal-accent/5 px-3 py-2 text-sm">
+                <Loader2 className="size-4 shrink-0 animate-spin text-teal-accent" />
+                <span className="text-muted-foreground">Thinking{elapsed >= 2 ? `… (${elapsed}s)` : "…"}</span>
+                {elapsed >= 30 ? (
+                  <span className="text-amber-600 dark:text-amber-400">
+                    taking a while - still waiting, replies are capped at 2 minutes
+                  </span>
+                ) : null}
+              </div>
+            ) : null}
+            {error ? (
+              <p role="alert" className="rounded-lg border border-red-200 bg-red-50 p-2.5 text-xs text-red-700 dark:border-red-900 dark:bg-red-950 dark:text-red-300">
+                {error}
+              </p>
+            ) : null}
+          </div>
+
+          <div className="flex items-end gap-2 border-t px-4 py-3">
+            <Textarea
+              value={input}
+              onChange={(e) => setInput(e.target.value)}
+              onKeyDown={(e) => {
+                if (e.key === "Enter" && !e.shiftKey) {
+                  e.preventDefault();
+                  void send();
+                }
+              }}
+              placeholder="Ask a question…"
+              rows={2}
+              className="min-h-0 flex-1 resize-none bg-card text-sm"
+            />
+            <Button onClick={send} disabled={busy || input.trim() === ""} size="icon" aria-label="Send">
+              {busy ? <Loader2 className="size-4 animate-spin" /> : <Send className="size-4" />}
+            </Button>
+          </div>
+        </DialogContent>
+      </Dialog>
+    </>
+  );
+}
