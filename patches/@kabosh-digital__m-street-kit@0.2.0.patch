index 0000000000000000000000000000000000000000..a1e88ae7b465a2a94e748bccb0361374ab6d2730
--- /dev/null
+++ b/src/components/RefreshButton.tsx
@@ -0,0 +1,24 @@
+"use client";
+
+import { useTransition } from "react";
+import { useRouter } from "next/navigation";
+import { RefreshCw } from "lucide-react";
+
+/** Re-runs the current page's Server Components for fresh data, keeping scroll and client state. */
+export function RefreshButton({ label = "Refresh" }: { label?: string }) {
+  const router = useRouter();
+  const [pending, startTransition] = useTransition();
+
+  return (
+    <button
+      type="button"
+      onClick={() => startTransition(() => router.refresh())}
+      disabled={pending}
+      title={label}
+      aria-label={label}
+      className="inline-flex size-9 shrink-0 items-center justify-center rounded-lg border border-border bg-card text-muted-foreground hover:bg-muted/50 hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-accent disabled:opacity-60"
+    >
+      <RefreshCw aria-hidden className={`size-4 ${pending ? "animate-spin" : ""}`} />
+    </button>
+  );
+}
