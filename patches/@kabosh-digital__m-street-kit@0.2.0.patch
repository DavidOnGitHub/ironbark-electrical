diff --git a/src/routes/api/app-assistant/route.ts b/src/routes/api/app-assistant/route.ts
new file mode 100644
index 0000000000000000000000000000000000000000..82656d6f31c22c87016f21abd4639ad8824955f4
--- /dev/null
+++ b/src/routes/api/app-assistant/route.ts
@@ -0,0 +1,105 @@
+import { NextRequest } from "next/server";
+import { prisma } from "@kabosh-digital/workflow-schema";
+import { requireRole } from "../../../lib/auth";
+import { Policy } from "../../../lib/policy";
+import { prepareAppAssistantRequest } from "../../../lib/appAssistantServer";
+import { runAppAssistantLoop } from "../../../lib/appAssistantLoop";
+import { sseEncode } from "../../../lib/assistantStream";
+import { CROSS_SITE_REFUSED, isSameOriginRequest } from "../../../lib/sameOrigin";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+/**
+ * App-level assistant - the floating chat (PLAN-app-assistant.md Phase B).
+ * Unlike /api/assistant (one WorkflowDefinition's graph, edit proposals),
+ * this one answers read-only questions over the whole business/app via a
+ * tool-calling loop (appAssistantLoop.ts) - so unlike that route, there is no
+ * per-token upstream stream to relay: the full reply is computed first, then
+ * sent as a single `delta` event, keeping the same SSE envelope
+ * (sseEncode/parseAssistantSse) the dialog already knows how to read.
+ */
+export async function POST(req: NextRequest) {
+  if (!isSameOriginRequest(req.headers)) return Response.json(CROSS_SITE_REFUSED, { status: 403 });
+  let user;
+  try {
+    user = await requireRole(Policy.APP_ASSISTANT);
+  } catch {
+    return Response.json({ error: "Unauthorized: sign in as an Owner or Office user to use the assistant." }, { status: 401 });
+  }
+
+  let body: { messages?: unknown; conversationId?: unknown };
+  try {
+    body = await req.json();
+  } catch {
+    return Response.json({ error: "Invalid JSON body." }, { status: 400 });
+  }
+  if (body.conversationId !== undefined && body.conversationId !== null && typeof body.conversationId !== "string") {
+    return Response.json({ error: "Invalid conversationId." }, { status: 400 });
+  }
+  // null/undefined both mean "start a new thread" - the client omits the
+  // field on a first message, but tolerate null defensively.
+  let conversationId = typeof body.conversationId === "string" ? body.conversationId : null;
+
+  const prepared = await prepareAppAssistantRequest(body.messages);
+  if ("error" in prepared) {
+    return Response.json({ error: prepared.error }, { status: 400 });
+  }
+
+  const question = prepared.history[prepared.history.length - 1].content;
+  if (conversationId) {
+    const existing = await prisma.appAssistantConversation.findUnique({ where: { id: conversationId } });
+    if (!existing) return Response.json({ error: "Conversation not found." }, { status: 404 });
+    if (existing.userId !== user.id) return Response.json({ error: "Forbidden." }, { status: 403 });
+  } else {
+    const created = await prisma.appAssistantConversation.create({
+      data: { userId: user.id, title: question.slice(0, 80) },
+    });
+    conversationId = created.id;
+  }
+  await prisma.appAssistantConversationMessage.create({ data: { conversationId, role: "user", content: question } });
+
+  const stream = new ReadableStream<Uint8Array>({
+    async start(controller) {
+      const write = (s: string) => controller.enqueue(new TextEncoder().encode(s));
+      write(sseEncode({ conversationId }));
+      let reply = "";
+      let failed = false;
+      try {
+        reply = await runAppAssistantLoop({
+          provider: prepared.provider,
+          apiKey: prepared.apiKey,
+          system: prepared.system,
+          history: prepared.history,
+          tools: prepared.tools,
+        });
+        write(sseEncode({ delta: reply }));
+        write(sseEncode({ done: true }));
+      } catch (err) {
+        failed = true;
+        write(sseEncode({ error: err instanceof Error ? err.message : "Assistant request failed." }));
+      } finally {
+        // Close FIRST, then persist: a slow DB write must never delay the
+        // client's terminal event (it would look like the reply stalled).
+        try {
+          controller.close();
+        } catch {
+          // client already disconnected - nothing to flush
+        }
+        if (!failed && reply) {
+          await prisma.appAssistantConversationMessage
+            .create({ data: { conversationId, role: "assistant", content: reply } })
+            .catch((err) => console.warn("[app-assistant] reply persistence failed", err));
+        }
+      }
+    },
+  });
+
+  return new Response(stream, {
+    headers: {
+      "Content-Type": "text/event-stream",
+      "Cache-Control": "no-cache, no-transform",
+      Connection: "keep-alive",
+    },
+  });
+}
