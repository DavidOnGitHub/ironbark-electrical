diff --git a/src/lib/appAssistant.ts b/src/lib/appAssistant.ts
new file mode 100644
index 0000000000000000000000000000000000000000..440d930aab1204a0bb26976ab2fb1408ddde4099
--- /dev/null
+++ b/src/lib/appAssistant.ts
@@ -0,0 +1,60 @@
+/**
+ * Pure helpers for the app-level assistant (PLAN-app-assistant.md Phase A) -
+ * no next-auth / network / prisma, unit-tested in appAssistant.test.ts.
+ * `appAssistantServer.ts` wires these to an LLM connector and runs the
+ * actual tool-calling loop against OpenAI-compatible/Anthropic APIs.
+ *
+ * Unlike the workflow assistant (assistant.ts), which embeds one whole
+ * workflow graph into the prompt, the app assistant answers from knowledge of
+ * the whole business/app - too much to embed in one static prompt - so it
+ * looks things up on demand via named tool calls instead.
+ */
+
+/** A single named, reviewed lookup the assistant may call - never a raw query
+ * the model can shape itself. `handler` runs with the same visibility the
+ * rest of the app already applies (it's expected to re-derive the signed-in
+ * user itself, e.g. via currentViewer(), not trust a caller-supplied user). */
+export interface AppAssistantTool {
+  /** Name the model sees and calls, e.g. "listOverdueInvoices". */
+  name: string;
+  description: string;
+  /** JSON Schema object describing the tool's arguments. */
+  paramsSchema: Record<string, unknown>;
+  handler: (args: Record<string, unknown>) => Promise<unknown>;
+}
+
+function isRecord(v: unknown): v is Record<string, unknown> {
+  return typeof v === "object" && v !== null && !Array.isArray(v);
+}
+
+/** Dispatches one model-requested tool call: resolves the matching tool and
+ * runs its handler. Any failure (unknown tool, the handler itself throwing)
+ * is caught and turned into an error string rather than propagating - one bad
+ * tool call must not end the whole turn; the model gets a chance to recover
+ * (retry with different arguments, try another tool, or give up and say so). */
+export async function dispatchAppAssistantTool(tools: AppAssistantTool[], name: string, args: unknown): Promise<unknown> {
+  const tool = tools.find((t) => t.name === name);
+  if (!tool) return `Error: no tool named "${name}" is available.`;
+  try {
+    return await tool.handler(isRecord(args) ? args : {});
+  } catch (err) {
+    return `Error executing tool "${name}": ${err instanceof Error ? err.message : String(err)}`;
+  }
+}
+
+/** The system prompt for the app assistant: who it is, what it may do, and
+ * the merged kit+business tool catalog (tools are declared separately to the
+ * LLM call via the wire format's own tools param - this prompt only
+ * describes the assistant's scope and ground rules, not the tool schemas
+ * themselves, which the model already sees structured). */
+export function buildAppAssistantSystemPrompt(businessName: string, tools: AppAssistantTool[]): string {
+  return [
+    `You are the assistant inside ${businessName}'s workflow console, available to the Owner and Office staff.`,
+    "Answer questions using the tools available to you - call a tool whenever you need current data rather than guessing. Never invent figures, counts, or statuses.",
+    "If none of the available tools can answer the question, say so plainly instead of guessing.",
+    "Be concise and practical. Prefer a short, direct answer over a long one.",
+    tools.length > 0
+      ? `Available tools: ${tools.map((t) => t.name).join(", ")}.`
+      : "No tools are currently registered - say so if asked something that would need one.",
+  ].join("\n");
+}
diff --git a/src/lib/appAssistantLoop.ts b/src/lib/appAssistantLoop.ts
new file mode 100644
index 0000000000000000000000000000000000000000..39419b81debc9c1877f6b4eb09dc5f32227643fa
--- /dev/null
+++ b/src/lib/appAssistantLoop.ts
@@ -0,0 +1,173 @@
+import type { LlmProviderConfig } from "@kabosh-digital/workflow-temporal/llm/llmProviders";
+import { dispatchAppAssistantTool, type AppAssistantTool } from "./appAssistant";
+import type { AssistantMessage } from "./assistant";
+
+/**
+ * The app assistant's tool-calling loop (PLAN-app-assistant.md Phase A) -
+ * dual OpenAI-compatible/Anthropic wire format, mirroring workflow-temporal's
+ * aiAgent.ts + aiAgentAnthropic.ts but adapted to call plain tool handlers
+ * instead of dispatching into the workflow step registry, with no
+ * submit_result/PDF handling (the app assistant only ever answers in plain
+ * text, with no file-attachment inputs).
+ *
+ * Deliberately split out of appAssistantServer.ts: this module only imports
+ * pure/type-only dependencies (no prisma, no next-auth, no Next.js) so it can
+ * be unit-tested directly against a fake `fetchImpl`, the same way
+ * assistant.ts's pure helpers are tested separately from assistantServer.ts's
+ * DB-touching connector resolution.
+ */
+
+/** Upper bound on model round-trips in the tool-calling loop (requests, not
+ * individual tool calls within one round) - same bound shape as aiAgent's
+ * ConfigSchema.maxToolCalls, just a fixed default since there's no per-node
+ * author to configure it here. */
+export const APP_ASSISTANT_MAX_TOOL_CALLS = 6;
+
+/** Every round is a non-streaming request: the loop must inspect tool_calls
+ * before deciding whether to continue, so there is nothing to stream until
+ * the model lands on a plain-text final answer. The route handler (Phase B)
+ * sends that complete answer to the browser as a single SSE delta rather
+ * than token-by-token - see PLAN-app-assistant.md's streaming note. */
+export interface RunAppAssistantLoopInput {
+  provider: LlmProviderConfig;
+  apiKey: string;
+  system: string;
+  history: AssistantMessage[];
+  tools: AppAssistantTool[];
+  maxToolCalls?: number;
+  /** Test-only seam - production callers omit it and get the real `fetch`. */
+  fetchImpl?: typeof fetch;
+}
+
+export async function runAppAssistantLoop(input: RunAppAssistantLoopInput): Promise<string> {
+  const maxToolCalls = input.maxToolCalls ?? APP_ASSISTANT_MAX_TOOL_CALLS;
+  const fetchImpl = input.fetchImpl ?? fetch;
+  return input.provider.kind === "anthropic"
+    ? runAnthropicToolLoop({ ...input, provider: input.provider, maxToolCalls, fetchImpl })
+    : runOpenAiCompatibleToolLoop({ ...input, provider: input.provider, maxToolCalls, fetchImpl });
+}
+
+async function upstreamError(res: Response): Promise<string> {
+  const detail = await res.text().catch(() => "");
+  return `LLM provider error (${res.status}): ${detail.slice(0, 300)}`;
+}
+
+interface LoopRunParams {
+  provider: LlmProviderConfig;
+  apiKey: string;
+  system: string;
+  history: AssistantMessage[];
+  tools: AppAssistantTool[];
+  maxToolCalls: number;
+  fetchImpl: typeof fetch;
+}
+
+/** OpenAI chat-completions wire format (also used by Gemini's OpenAI
+ * compatibility shim) - see aiAgent.ts's identical split for the full
+ * rationale. */
+async function runOpenAiCompatibleToolLoop({ provider, apiKey, system, history, tools, maxToolCalls, fetchImpl }: LoopRunParams): Promise<string> {
+  if (provider.kind !== "openai-compatible") throw new Error("runOpenAiCompatibleToolLoop: wrong provider kind");
+  const toolDefs = tools.map((t) => ({
+    type: "function" as const,
+    function: { name: t.name, description: t.description, parameters: t.paramsSchema },
+  }));
+  const isOpenAi = provider.key === "openai";
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  const messages: any[] = [{ role: "system", content: system }, ...history.map((m) => ({ role: m.role, content: m.content }))];
+
+  for (let turn = 0; turn < maxToolCalls; turn++) {
+    const res = await fetchImpl(`${provider.baseURL}/chat/completions`, {
+      method: "POST",
+      headers: { "Content-Type": "application/json", Authorization: `Bearer ${apiKey}` },
+      body: JSON.stringify({
+        model: provider.defaultModel,
+        messages,
+        tools: toolDefs.length > 0 ? toolDefs : undefined,
+        // See aiAgent.ts: gpt-5.x reasoning models need max_completion_tokens
+        // (not max_tokens) and reject function tools unless reasoning_effort
+        // is "none"; other openai-compatible providers (Gemini) use the
+        // legacy names/don't recognize reasoning_effort.
+        ...(isOpenAi ? { max_completion_tokens: 2048 } : { max_tokens: 2048, temperature: 0.3 }),
+        ...(isOpenAi && toolDefs.length > 0 ? { reasoning_effort: "none" as const } : {}),
+        stream: false,
+      }),
+      signal: AbortSignal.timeout(60_000),
+    });
+    if (!res.ok) throw new Error(await upstreamError(res));
+    const data = await res.json();
+    const message = data.choices?.[0]?.message;
+    if (!message) throw new Error("App assistant: model returned no choices");
+
+    const toolCalls = message.tool_calls ?? [];
+    if (toolCalls.length === 0) return message.content ?? "";
+
+    messages.push(message);
+    for (const toolCall of toolCalls) {
+      if (toolCall.type !== "function") {
+        messages.push({ role: "tool", tool_call_id: toolCall.id, content: `Error: unsupported tool call type "${toolCall.type}".` });
+        continue;
+      }
+      let args: unknown;
+      try {
+        args = toolCall.function.arguments ? JSON.parse(toolCall.function.arguments) : {};
+      } catch (err) {
+        messages.push({
+          role: "tool",
+          tool_call_id: toolCall.id,
+          content: `Error: invalid JSON arguments for tool "${toolCall.function.name}": ${err instanceof Error ? err.message : String(err)}`,
+        });
+        continue;
+      }
+      const result = await dispatchAppAssistantTool(tools, toolCall.function.name, args);
+      messages.push({ role: "tool", tool_call_id: toolCall.id, content: typeof result === "string" ? result : JSON.stringify(result) });
+    }
+  }
+  throw new Error(`App assistant: exceeded maxToolCalls (${maxToolCalls}) without a final response`);
+}
+
+/** Anthropic Messages API wire format - see aiAgentAnthropic.ts's identical
+ * split for the full rationale (separate system param, tool_use/tool_result
+ * content blocks instead of role:"tool" messages, already-parsed tool
+ * input). */
+async function runAnthropicToolLoop({ provider, apiKey, system, history, tools, maxToolCalls, fetchImpl }: LoopRunParams): Promise<string> {
+  const toolDefs = tools.map((t) => ({ name: t.name, description: t.description, input_schema: t.paramsSchema }));
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  const messages: any[] = history.map((m) => ({ role: m.role, content: m.content }));
+
+  for (let turn = 0; turn < maxToolCalls; turn++) {
+    const res = await fetchImpl("https://api.anthropic.com/v1/messages", {
+      method: "POST",
+      headers: { "Content-Type": "application/json", "x-api-key": apiKey, "anthropic-version": "2023-06-01" },
+      body: JSON.stringify({
+        model: provider.defaultModel,
+        max_tokens: 2048,
+        system,
+        messages,
+        tools: toolDefs.length > 0 ? toolDefs : undefined,
+        stream: false,
+      }),
+      signal: AbortSignal.timeout(60_000),
+    });
+    if (!res.ok) throw new Error(await upstreamError(res));
+    const data = await res.json();
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    const content: any[] = data.content ?? [];
+    const toolUseBlocks = content.filter((b) => b.type === "tool_use");
+
+    if (toolUseBlocks.length === 0) {
+      return content
+        .filter((b) => b.type === "text")
+        .map((b) => b.text as string)
+        .join("");
+    }
+
+    messages.push({ role: "assistant", content });
+    const resultBlocks = [];
+    for (const block of toolUseBlocks) {
+      const result = await dispatchAppAssistantTool(tools, block.name, block.input);
+      resultBlocks.push({ type: "tool_result", tool_use_id: block.id, content: typeof result === "string" ? result : JSON.stringify(result) });
+    }
+    messages.push({ role: "user", content: resultBlocks });
+  }
+  throw new Error(`App assistant: exceeded maxToolCalls (${maxToolCalls}) without a final response`);
+}
diff --git a/src/lib/appAssistantServer.ts b/src/lib/appAssistantServer.ts
new file mode 100644
index 0000000000000000000000000000000000000000..84232176811392e4bccabadc62f1d67a8464557f
--- /dev/null
+++ b/src/lib/appAssistantServer.ts
@@ -0,0 +1,65 @@
+import { decryptSecrets, prisma } from "@kabosh-digital/workflow-schema";
+import { getLlmProvider, type LlmProviderConfig } from "@kabosh-digital/workflow-temporal/llm/llmProviders";
+import { getKitConfig } from "../config";
+import { displayName, getBranding } from "./branding";
+import { buildAppAssistantSystemPrompt, type AppAssistantTool } from "./appAssistant";
+import { getKitLevelAppAssistantTools } from "./appAssistantTools";
+import { sanitizeAssistantHistory, type AssistantMessage } from "./assistant";
+
+/**
+ * Server-side preparation for an app assistant call (PLAN-app-assistant.md
+ * Phase A) - modeled on assistantServer.ts's connector resolution (same
+ * "OpenAI preferred, any LLM_PROVIDER row as fallback" rule), generalized to
+ * not be scoped to one workflow definition. The actual tool-calling loop
+ * lives in appAssistantLoop.ts, kept separate because it has no prisma/
+ * next-auth dependency and so can be unit-tested directly; this module pulls
+ * those in (via getKitConfig/getKitLevelAppAssistantTools/prisma) and is
+ * exercised through the route handler + manual verification instead (same
+ * split, same reason, as the workflow assistant's assistant.ts/
+ * assistantServer.ts).
+ */
+
+export interface PreparedAppAssistantRequest {
+  system: string;
+  history: AssistantMessage[];
+  provider: LlmProviderConfig;
+  apiKey: string;
+  tools: AppAssistantTool[];
+}
+
+export async function prepareAppAssistantRequest(messages: unknown): Promise<{ error: string } | PreparedAppAssistantRequest> {
+  const history = sanitizeAssistantHistory(messages);
+  if (history.length === 0 || history[history.length - 1].role !== "user") {
+    return { error: "Nothing to ask - type a question first." };
+  }
+
+  const connector =
+    (await prisma.connector.findFirst({
+      where: { type: "LLM_PROVIDER", config: { path: ["provider"], equals: "openai" } },
+      orderBy: { createdAt: "asc" },
+    })) ??
+    (await prisma.connector.findFirst({ where: { type: "LLM_PROVIDER" }, orderBy: { createdAt: "asc" } }));
+  if (!connector) {
+    return { error: "No LLM connector is configured - add one on the Connectors page first." };
+  }
+
+  const secrets = decryptSecrets(connector.secretBlob ?? "");
+  const apiKey = typeof secrets.apiKey === "string" ? secrets.apiKey : "";
+  if (!apiKey) return { error: `LLM connector "${connector.name}" has no API key configured.` };
+
+  const providerKey =
+    typeof (connector.config as { provider?: unknown } | null)?.provider === "string"
+      ? ((connector.config as { provider?: string }).provider as string)
+      : "";
+  if (!providerKey) return { error: `LLM connector "${connector.name}" has no provider configured.` };
+
+  const tools = [...getKitLevelAppAssistantTools(), ...(getKitConfig().appAssistantTools ?? [])];
+
+  return {
+    system: buildAppAssistantSystemPrompt(displayName(getBranding()), tools),
+    history,
+    provider: getLlmProvider(providerKey),
+    apiKey,
+    tools,
+  };
+}
diff --git a/src/lib/appAssistantTools.ts b/src/lib/appAssistantTools.ts
new file mode 100644
index 0000000000000000000000000000000000000000..18b426b6e1022faec848039e4696338e9c890494
--- /dev/null
+++ b/src/lib/appAssistantTools.ts
@@ -0,0 +1,110 @@
+/**
+ * Kit-level tools for the app assistant (PLAN-app-assistant.md Phase A):
+ * thin wrappers around the queries already powering the console pages, so
+ * visibility/ownership scoping (isAdminViewer, ownedByViewer - applied inside
+ * each query via currentViewer()) is inherited for free rather than
+ * reimplemented here. Every business adds its own tools on top via
+ * KitConfig.appAssistantTools; these are always available.
+ */
+import type { AppAssistantTool } from "./appAssistant";
+import { listDefinitions } from "./queries/definitions";
+import { listInstances, getInstance } from "./queries/instances";
+import { listPendingTasks } from "./queries/tasks";
+import { listConnectorSummaries } from "./queries/connectors";
+import type { QueryResult } from "./queries/shared";
+
+/** Unwraps a QueryResult for a tool handler: data on success, throws the
+ * query's own error message on failure - dispatchAppAssistantTool's catch
+ * turns that into a string the model sees, same as any other tool failure. */
+async function unwrap<T>(result: Promise<QueryResult<T>>): Promise<T> {
+  const r = await result;
+  if (!r.ok) throw new Error(r.error);
+  return r.data;
+}
+
+export function getKitLevelAppAssistantTools(): AppAssistantTool[] {
+  return [
+    {
+      name: "listWorkflowDefinitions",
+      description: "Lists the workflow definitions visible to the current user, with their status and version.",
+      paramsSchema: { type: "object", properties: {}, additionalProperties: false },
+      handler: async () => {
+        const rows = await unwrap(listDefinitions());
+        return rows.map((d) => ({ id: d.id, name: d.name, status: d.status, version: d.version, createdAt: d.createdAt }));
+      },
+    },
+    {
+      name: "listWorkflowInstances",
+      description:
+        "Lists recent workflow runs (instances) visible to the current user, optionally filtered by status. Each entry includes which workflow it belongs to and its current status.",
+      paramsSchema: {
+        type: "object",
+        properties: {
+          status: { type: "string", enum: ["RUNNING", "COMPLETED", "FAILED", "CANCELLED"], description: "Optional status filter." },
+          limit: { type: "integer", minimum: 1, maximum: 50, description: "Max rows to return (default 20)." },
+        },
+        additionalProperties: false,
+      },
+      handler: async (args) => {
+        const rows = await unwrap(listInstances());
+        const status = typeof args.status === "string" ? args.status : undefined;
+        const limit = typeof args.limit === "number" ? args.limit : 20;
+        return rows
+          .filter((i) => !status || i.status === status)
+          .slice(0, limit)
+          .map((i) => ({
+            id: i.id,
+            definitionName: i.definition.name,
+            status: i.status,
+            currentNodeLabel: i.currentNodeLabel,
+            startedAt: i.startedAt,
+            completedAt: i.completedAt,
+          }));
+      },
+    },
+    {
+      name: "getWorkflowInstance",
+      description: "Gets the full detail of one workflow run by id: its status, current node, and pending/recent tasks.",
+      paramsSchema: {
+        type: "object",
+        properties: { instanceId: { type: "string" } },
+        required: ["instanceId"],
+        additionalProperties: false,
+      },
+      handler: async (args) => {
+        if (typeof args.instanceId !== "string" || !args.instanceId) throw new Error("instanceId is required");
+        const instance = await unwrap(getInstance(args.instanceId));
+        return {
+          id: instance.id,
+          definitionName: instance.definition.name,
+          status: instance.status,
+          currentNodeId: instance.currentNodeId,
+          startedAt: instance.startedAt,
+          completedAt: instance.completedAt,
+          pendingTasks: instance.tasks.filter((t) => t.status === "PENDING").map((t) => ({ id: t.id, nodeId: t.nodeId, createdAt: t.createdAt })),
+        };
+      },
+    },
+    {
+      name: "listPendingTasks",
+      description: "Lists human tasks currently waiting on someone (e.g. an approval), visible to the current user.",
+      paramsSchema: { type: "object", properties: {}, additionalProperties: false },
+      handler: async () => {
+        const rows = await unwrap(listPendingTasks());
+        return rows.map((t) => ({
+          id: t.id,
+          instanceId: t.instanceId,
+          definitionName: t.instance.definition.name,
+          nodeLabel: t.nodeLabel,
+          createdAt: t.createdAt,
+        }));
+      },
+    },
+    {
+      name: "listConnectors",
+      description: "Lists the connected apps/services (connectors) configured in this console, by name and type. Never returns secrets.",
+      paramsSchema: { type: "object", properties: {}, additionalProperties: false },
+      handler: async () => unwrap(listConnectorSummaries()),
+    },
+  ];
+}
