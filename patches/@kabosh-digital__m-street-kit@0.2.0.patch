diff --git a/src/routes/api/app-assistant/conversations/[id]/route.ts b/src/routes/api/app-assistant/conversations/[id]/route.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a28126c2b34de38be10bed4619aa649f39a2584e
